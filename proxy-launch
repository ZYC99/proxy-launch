}

clash_on() {
  clash_build || return 1
  if [ "$DRY_RUN" -eq 0 ]; then
    if [ "$(id -u)" -eq 0 ]; then
      # launchd 的 GUI 域属于登录用户，root 无法 bootstrap；登录项需以用户身份安装
      c_warn "以 root 运行，跳过登录项安装（若未装过，请以当前用户执行 proxy-launch clash agent）"
    else
      clash_agent_install || return 1
    fi
    sleep 2
    nc -z -w 2 127.0.0.1 "$MIHOMO_PORT" || { c_err "mihomo 端口 ${MIHOMO_PORT} 未监听（先执行 proxy-launch clash agent）"; return 1; }
  else
    clash_agent_install
  fi
  # 系统代理指向本地 mihomo（HTTP 与 HTTPS 同一端口）
  local svc; svc="${PROXY_SERVICE:-$(active_service)}"
  run_root networksetup -setautoproxystate "$svc" off
  run_root networksetup -setsocksfirewallproxystate "$svc" off
  run_root networksetup -setwebproxy         "$svc" 127.0.0.1 "$MIHOMO_PORT"
  run_root networksetup -setsecurewebproxy   "$svc" 127.0.0.1 "$MIHOMO_PORT"
  run_root networksetup -setwebproxystate    "$svc" on
  run_root networksetup -setsecurewebproxystate "$svc" on
  [ "$DRY_RUN" -eq 0 ] && c_ok "规则分流已启用：系统代理 → 127.0.0.1:${MIHOMO_PORT}（国内直连 / 其余走 sharenet）"
  return 0
}

clash_off() {
  local svc; svc="${PROXY_SERVICE:-$(active_service)}"
  if [ "$DRY_RUN" -eq 0 ]; then
    launchctl bootout "gui/$(id -u)/${AGENT_LABEL}" 2>/dev/null || true
    rm -f "$AGENT_PLIST"
  fi
  # 回到静态 HTTP/HTTPS 代理（已知可用状态）
  run_root networksetup -setautoproxystate "$svc" off
  run_root networksetup -setwebproxy       "$svc" "$PROXY_HOST" "$PROXY_PORT"
  run_root networksetup -setsecurewebproxy "$svc" "$PROXY_HOST" "$PROXY_PORT"
  run_root networksetup -setwebproxystate   "$svc" on
  run_root networksetup -setsecurewebproxystate "$svc" on
  [ "$DRY_RUN" -eq 0 ] && c_ok "已关闭规则分流，恢复静态 HTTP/HTTPS 代理"
  return 0
}

clash_status() {
  local svc; svc="${PROXY_SERVICE:-$(active_service)}"
  printf '  内核: %s\n' "$MIHOMO_BIN"
  printf '  配置: %s %s\n' "$MIHOMO_CFG" "$([ -f "$MIHOMO_CFG" ] && echo 存在 || echo 缺失)"
  printf '  端口 7890: '
  nc -z -w 2 127.0.0.1 "$MIHOMO_PORT" >/dev/null 2>&1 && c_ok "监听中" || c_warn "未监听"
  if launchctl print "gui/$(id -u)/${AGENT_LABEL}" >/dev/null 2>&1; then
    c_ok "登录项运行中（${AGENT_LABEL}）"
  else
    c_warn "登录项未安装（proxy-launch clash on 会安装）"
  fi
  c_info "系统代理（${svc}）:"
  scutil --proxy | grep -Ei "HTTPEnable|HTTPSEnable|HTTPProxy|HTTPPort|SOCKSEnable|ProxyAutoConfigEnable" | sed 's/^/    /'
  return 0
}

