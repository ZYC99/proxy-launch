#!/bin/bash
# proxy-launch —— 通过 sharenet 隧道代理启动指定应用
#
# 用法: proxy-launch [-h] [-l] [-d] [-s] [-S|-H] <应用名> [传给应用的参数...]
# 应用清单见 proxy-launch -h
#
# 设计要点:
#   1. ChatGPT、Claude 桌面端和 CLI 默认 HTTP 8443。
#      可用环境变量 PROXY_HOST / PROXY_PORT / SOCKS_PORT 覆盖地址和端口。
#   2. GUI 应用（Claude 桌面端、Chrome）用 Chromium 的 --proxy-server 参数启动，
#      不改动系统网络设置；加 -s 才写系统代理（需要 sudo）。
#   3. 命令行工具（claude-cli / codex / git / npm / pip / brew）通过环境变量注入代理。
#   4. ChatGPT / Gemini 或 -s 会修改系统代理；--off 关闭代理，不恢复历史配置。

set -uo pipefail
HOME="${HOME:-/var/root}"; export HOME   # LaunchDaemon 以 root 运行时没有 HOME

SELF="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")"
# 以 root（osascript 管理员）运行时 HOME=/var/root，会写错配置目录；
# 定位到脚本属主的真实 home，保证 CONFIG_DIR 始终指向用户配置。
if [ "$(id -u)" -eq 0 ]; then
  _own="$(stat -f '%Su' /dev/console 2>/dev/null || stat -f '%Su' "$SELF" 2>/dev/null || echo "${SUDO_USER:-root}")"
  HOME="$(eval echo "~${_own}")"
fi

PROXY_HOST="${PROXY_HOST:-172.100.0.2}"
PROXY_PORT="${PROXY_PORT:-8443}"
SOCKS_PORT="${SOCKS_PORT:-1080}"
CHROME_PROFILE="${CHROME_PROXY_PROFILE:-$HOME/.chrome-proxy-profile}"

MODE="app"          # app | system | off
USE_SOCKS=0
PROTOCOL_OVERRIDE=""
DRY_RUN=0
LIST_ONLY=0

# 系统代理的类型：http（默认，写 HTTP/HTTPS 端口）或 socks（写 SOCKS5 端口）
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/proxy-launch"
MIHOMO_BIN="${MIHOMO_BIN:-/Applications/Clash Verge.app/Contents/MacOS/verge-mihomo}"
MIHOMO_GEO_SRC="${MIHOMO_GEO_SRC:-$HOME/Library/Application Support/io.github.clash-verge-rev.clash-verge-rev}"
MIHOMO_DIR="$CONFIG_DIR/mihomo"
MIHOMO_CFG="$MIHOMO_DIR/config.yaml"
MIHOMO_PORT="${MIHOMO_PORT:-7890}"
MIHOMO_API="${MIHOMO_API:-127.0.0.1:9090}"
CONFIG_FILE="$CONFIG_DIR/config"
SYSTEM_KIND="${SYSTEM_KIND:-http}"
[ -r "$CONFIG_FILE" ] && . "$CONFIG_FILE"
SYSTEM_KIND="${SYSTEM_KIND:-http}"

c_info()  { printf '\033[36m%s\033[0m\n' "$*"; }
c_ok()    { printf '\033[32m%s\033[0m\n' "$*"; }
c_warn()  { printf '\033[33m%s\033[0m\n' "$*" >&2; }
c_err()   { printf '\033[31m%s\033[0m\n' "$*" >&2; }

proxy_url() {
  if [ "$USE_SOCKS" -eq 1 ]; then
    printf 'socks5h://%s:%s' "$PROXY_HOST" "$SOCKS_PORT"
  else
    printf 'http://%s:%s' "$PROXY_HOST" "$PROXY_PORT"
  fi
}

# Chromium 系列只认 socks5:// 语法，不能带 h
chromium_proxy() {
  if [ "$USE_SOCKS" -eq 1 ]; then
    printf 'socks5://%s:%s' "$PROXY_HOST" "$SOCKS_PORT"
  else
    proxy_url
  fi
}

select_protocol() {
  local kind="${PROTOCOL_OVERRIDE}"
  if [ -z "$kind" ]; then
    case "$1" in
      chatgpt|claude|claude-cli) kind="http" ;;
      gemini) kind="$SYSTEM_KIND" ;;
      *)
        if [ "$MODE" = "system" ]; then kind="$SYSTEM_KIND"; else kind="http"; fi
        ;;
    esac
  fi
  case "$kind" in
    socks) USE_SOCKS=1 ;;
    http) USE_SOCKS=0 ;;
    *) c_err "无效代理类型: $kind（仅支持 http / socks）"; return 2 ;;
  esac
  if [ "$1" = "claude-cli" ] && [ "$USE_SOCKS" -eq 1 ]; then
    c_err "Claude Code 不支持 SOCKS，请使用 proxy-launch claude-cli（HTTP）。"
    return 2
  fi
}

selected_port() {
  if [ "$USE_SOCKS" -eq 1 ]; then printf '%s' "$SOCKS_PORT"; else printf '%s' "$PROXY_PORT"; fi
}

app_names() {
  # 每行一个应用名，顺序即 -h 中的展示顺序
  printf '%s\n' claude chatgpt gemini chrome claude-cli codex zsh git npm pip brew curl status env
}

# 这里通过 macOS 系统代理配置原生 App；Chromium 应用使用独立启动参数。
needs_system_proxy() {
  case "$1" in
    chatgpt|gemini) return 0 ;;
    *) return 1 ;;
  esac
}

# ---- Google 网段直连修复 ----------------------------------------------------
# Gemini 会用裸 TCP 直连 Google 自有 IP（172.217.x / 142.250.x ...），完全不看系统代理，
# 在被墙的网络里就卡在 SYN_SENT → 表现为“无法访问网络”。
# 修法：把这些网段的路由指到 WARP 隧道口（默认 utun4），让它们走 Cloudflare 出去。
GOOGLE_NETS="172.217.0.0/16 142.250.0.0/15 142.251.0.0/16 216.58.192.0/19 74.125.0.0/16
108.177.0.0/17 172.253.0.0/16 64.233.160.0/19 209.85.128.0/17 216.239.32.0/19
66.102.0.0/20 72.14.192.0/18 23.236.48.0/20 199.36.128.0/19 173.194.0.0/16"
WARP_IF="${WARP_IF:-}"
LEARNED_FILE="$CONFIG_DIR/learned-cidrs"
LEARN_PROCS="${LEARN_PROCS:-Gemini ChatGPT}"

# root 下直接执行，普通用户加 sudo
run_root() {
  if [ "$(id -u)" -eq 0 ]; then run_cmd "$@"; else run_cmd sudo "$@"; fi
}

learned_nets() {
  [ -r "$LEARNED_FILE" ] || return 0
  awk 'NF && $1 !~ /^#/ {print $1}' "$LEARNED_FILE" | sort -u
}

all_nets() {
  printf '%s\n' $GOOGLE_NETS
  learned_nets
}

warp_interface() {
  local i
  if [ -n "$WARP_IF" ]; then printf '%s' "$WARP_IF"; return 0; fi
  # 跟随 172.100/24（sharenet 节点网段）所在接口，即 WARP 隧道
  i="$(netstat -rn 2>/dev/null | awk '$1=="172.100/24"{print $NF; exit}')"
  printf '%s' "${i:-utun4}"
}

route_ifc_for() {
  # 取网段内第一个可用地址（网络地址本身 route get 会落到 default），
  # 让内核做最长前缀匹配，避免 netstat 缩写格式的坑。
  local ip
  ip="$(printf '%s' "${1%%/*}" | awk -F. '{printf "%s.%s.%s.%d", $1,$2,$3,($4+1)%256}')"
  /sbin/route -n get "$ip" 2>/dev/null | awk '/interface:/{print $2; exit}'
}

# 注意（2026-11-17 修正）：早期版本把这些网段用内核路由指到 WARP(utun4)，
# 但 WARP 自身出口是 **CN**（Cloudflare 中国合作网络），导致 Gemini/Antigravity 的
# gRPC 请求被 Google 判为 "User location is not supported"。
# 现改为写入 mihomo 的 IP-CIDR 规则（RULE-SET,proxy-ip,PROXY），让流量经 sharenet（CA 出口）。
IP_RULES_FILE="$MIHOMO_DIR/rules/proxy-ip.yaml"

ip_rules_nets() {
  [ -r "$IP_RULES_FILE" ] || return 0
  awk -F"'" '/^[[:space:]]*- /{print $2}' "$IP_RULES_FILE" | sort -u
}

mihomo_reload() {
  local uid; uid="$(stat -f %u "$CONFIG_DIR" 2>/dev/null || id -u)"
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '+ launchctl kickstart -k gui/%s/%s\n' "$uid" "$AGENT_LABEL"
    return 0
  fi
  launchctl kickstart -k "gui/${uid}/${AGENT_LABEL}" >/dev/null 2>&1 \
    || c_warn "mihomo 重载失败，可手动: launchctl kickstart -k gui/$(id -u)/${AGENT_LABEL}"
}

write_ip_rules() {
  mkdir -p "$MIHOMO_DIR/rules" 2>/dev/null
  {
    printf 'payload:\n'
    local n; for n in "$@"; do printf "  - '%s'\n" "$n"; done
  } > "$IP_RULES_FILE"
}

google_routes_present() {
  local n cur; cur="$(ip_rules_nets)"
  for n in $(all_nets); do
    printf '%s\n' "$cur" | grep -qxF "$n" || return 1
  done
  return 0
}

google_routes_on() {
  local merged; merged="$( { ip_rules_nets; all_nets; } | sort -u )"
  if [ "$(ip_rules_nets)" != "$merged" ]; then
    write_ip_rules $merged
    mihomo_reload
    [ "$DRY_RUN" -eq 0 ] && c_ok "网段已写入 mihomo IP 规则（经 sharenet，CA 出口）"
  fi
  return 0
}

google_routes_off() {
  local keep n; keep="$(ip_rules_nets)"
  for n in $(all_nets); do
    keep="$(printf '%s\n' "$keep" | grep -vxF "$n")"
  done
  if [ "$(ip_rules_nets)" != "$(printf '%s\n' "$keep" | sort -u)" ]; then
    write_ip_rules $keep
    mihomo_reload
    [ "$DRY_RUN" -eq 0 ] && c_ok "网段 IP 规则已移除"
  fi
  return 0
}

google_routes_status() {
  local n cur; cur="$(ip_rules_nets)"
  c_info "后端: mihomo IP-CIDR 规则（${IP_RULES_FILE}）→ sharenet/CA"
  for n in $(all_nets); do
    if printf '%s\n' "$cur" | grep -qxF "$n"; then
      printf '  %-18s → PROXY ✅\n' "$n"
    else
      printf '  %-18s → 缺失 ❌（proxy-launch routes on）\n' "$n"
    fi
  done
  return 0
}

# 从 Gemini / ChatGPT 的**直连**（绕过代理）连接里学习新网段，写入 mihomo IP 规则。
learn_new_nets() {
  local name pid ip net added=0
  mkdir -p "$CONFIG_DIR" 2>/dev/null
  for name in $LEARN_PROCS; do
    for pid in $(pgrep -x "$name" 2>/dev/null); do
      lsof -i -nP -a -p "$pid" 2>/dev/null \
        | awk '/SYN_SENT|ESTABLISHED/ && /:443 \(/ {print $9}' \
        | sed 's/.*->//; s/:443.*//' \
        | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || true
    done
  done | sort -u | while read -r ip; do
    case "$ip" in 10.*|127.*|169.254.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|192.168.*|100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) continue ;; esac
    net="$(printf '%s' "$ip" | awk -F. '{printf "%s.%s.%s.0/24", $1,$2,$3}')"
    printf '%s\n' "$(all_nets)" | grep -qxF "$net" && continue
    grep -qxF "$net" "$LEARNED_FILE" 2>/dev/null && continue
    printf '%s\n' "$net" >> "$LEARNED_FILE"
    echo "$(date '+%F %T') learned $net (from $ip)" >> "$CONFIG_DIR/learn.log"
    added=$((added+1))
  done
  if [ "$added" -gt 0 ]; then
    google_routes_on
    [ "$DRY_RUN" -eq 0 ] && c_info "新学习 ${added} 个网段，已并入 mihomo IP 规则"
  fi
  return 0
}

# 幂等同步：补齐 IP 规则 + 清理旧特例路由 + 学习 + 日志裁剪 + 系统代理守护（常驻服务周期性调用）
routes_sync() {
  google_routes_on || return 1
  learn_new_nets || return 1
  logs_trim
  proxy_guard
  return 0
}

# WARP 重连会重置系统代理。若 mihomo 在跑而系统代理没指向它，自动改回，
# 避免 GUI 应用绕过规则网关（国内绕道/裸连被墙）。mihomo 没跑时不动系统代理。
proxy_guard() {
  clash_gateway_active || return 0
  local out svc
  out="$(scutil --proxy 2>/dev/null)"
  # 已经正确指向 7890 且无 PAC/SOCKS 干扰 → 不动
  if printf '%s\n' "$out" | grep -q "HTTPProxy : 127.0.0.1" \
     && printf '%s\n' "$out" | grep -q "HTTPPort : ${MIHOMO_PORT}" \
     && printf '%s\n' "$out" | grep -q "HTTPEnable : 1" \
     && ! printf '%s\n' "$out" | grep -Eq "ProxyAutoConfigEnable : 1|SOCKSEnable : 1"; then
    return 0
  fi
  svc="${PROXY_SERVICE:-$(active_service)}"
  [ -n "$svc" ] || return 0
  run_root networksetup -setautoproxystate "$svc" off
  run_root networksetup -setsocksfirewallproxystate "$svc" off
  run_root networksetup -setwebproxy       "$svc" 127.0.0.1 "$MIHOMO_PORT"
  run_root networksetup -setsecurewebproxy "$svc" 127.0.0.1 "$MIHOMO_PORT"
  run_root networksetup -setwebproxystate   "$svc" on
  run_root networksetup -setsecurewebproxystate "$svc" on
  [ "$DRY_RUN" -eq 0 ] && c_ok "系统代理漂移已纠正 → 127.0.0.1:${MIHOMO_PORT}"
  return 0
}

# 日志裁剪：随常驻服务每个周期顺手做，不额外增加定时任务。
# 注意：对 launchd 重定向的日志文件（sb.log / mihomo.log / proxy-routes.log）用原地截断
# （写入临时文件后 cp 覆盖），避免 mv 替换 inode 后常驻进程仍写入已 unlink 的旧文件。
logs_trim() {
  local f
  # 学习日志：超过 500 行只留最后 200 行
  f="$CONFIG_DIR/learn.log"
  if [ -f "$f" ] && [ "$(wc -l < "$f" | tr -d ' ')" -gt 500 ]; then
    tail -n 200 "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  fi
  # sing-box 日志：超过 5 MB 只留最后 2000 行（原地覆盖保留 inode）
  f="$SB_DIR/sb.log"
  if [ -f "$f" ] && [ "$(stat -f %z "$f" 2>/dev/null || echo 0)" -gt 5242880 ]; then
    tail -n 2000 "$f" > "$f.tmp" && cp "$f.tmp" "$f" && rm -f "$f.tmp"
  fi
  # mihomo 内核日志：超过 3 MB 只留最后 1000 行
  f="$MIHOMO_DIR/mihomo.log"
  if [ -f "$f" ] && [ "$(stat -f %z "$f" 2>/dev/null || echo 0)" -gt 3145728 ]; then
    tail -n 1000 "$f" > "$f.tmp" && cp "$f.tmp" "$f" && rm -f "$f.tmp"
  fi
  # 常驻服务自身日志：超过 1 MB 只留最后 500 行
  f="/var/log/proxy-routes.log"
  if [ -f "$f" ] && [ "$(stat -f %z "$f" 2>/dev/null || echo 0)" -gt 1048576 ]; then
    tail -n 500 "$f" > "$f.tmp" && cp "$f.tmp" "$f" && rm -f "$f.tmp"
  fi
  return 0
}

# ---- Clash(mihomo) 规则分流：国内直连、其余走 sharenet --------------------------
# 相比 PAC：规则可基于 GEOSITE(域名库) + GEOIP(IP 归属) 判断，且由独立内核统一处理
# DNS 与连接，不依赖各 App 对 PAC 的支持程度。使用 Clash Verge 自带内核与 geo 数据。
AGENT_LABEL="com.zyc.sharenet-gateway"
AGENT_PLIST="$HOME/Library/LaunchAgents/${AGENT_LABEL}.plist"
# 旧标签（早期版本用过），安装时自动清理
LEGACY_AGENT_LABELS="com.zyc.proxy-clash"

TUN_LABEL="com.zyc.sharenet-tun"
TUN_PLIST="/Library/LaunchDaemons/${TUN_LABEL}.plist"

clash_tun_on() {
  MIHOMO_TUN=1 clash_build || return 1
  if [ "$DRY_RUN" -eq 1 ]; then printf '+ install root TUN daemon %s\n' "$TUN_PLIST"; return 0; fi
  # 先停用户级实例释放端口（用配置目录属主的 uid，root 的 id -u=0 停不掉 gui 域）
  local owner_uid; owner_uid="$(stat -f %u "$CONFIG_DIR" 2>/dev/null || id -u)"
  launchctl bootout "gui/${owner_uid}/${AGENT_LABEL}" 2>/dev/null || true
  sleep 1
  local tmp; tmp="$(mktemp)"
  cat > "$tmp" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${TUN_LABEL}</string>
  <key>ProgramArguments</key>
  <array><string>${MIHOMO_BIN}</string><string>-d</string><string>${MIHOMO_DIR}</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>${MIHOMO_DIR}/tun.log</string>
  <key>StandardErrorPath</key><string>${MIHOMO_DIR}/tun.log</string>
</dict>
</plist>
PLIST
  run_root /bin/cp "$tmp" "$TUN_PLIST" && run_root /bin/chmod 644 "$TUN_PLIST" && rm -f "$tmp"
  run_root /bin/launchctl bootout system "$TUN_PLIST" >/dev/null 2>&1 || true
  run_root /bin/launchctl bootstrap system "$TUN_PLIST" || { c_err "TUN daemon 启动失败"; return 1; }
  sleep 3
  nc -z -w 2 127.0.0.1 "$MIHOMO_PORT" || { c_err "TUN 模式端口未监听"; return 1; }
  c_ok "TUN 模式已启用（root daemon，接管全部流量；WARP/sharenet 已排除防环路）"
  return 0
}

clash_tun_off() {
  if [ "$DRY_RUN" -eq 1 ]; then printf '+ remove root TUN daemon, restore user agent\n'; return 0; fi
  run_root /bin/launchctl bootout system "$TUN_PLIST" >/dev/null 2>&1 || true
  run_root /bin/rm -f "$TUN_PLIST"
  MIHOMO_TUN=0 clash_build || return 1
  clash_agent_install || return 1
  c_ok "已退出 TUN 模式，恢复用户级 mihomo（仅代理感知流量）"
  return 0
}

# ---- sing-box TUN（macOS 更稳的 TUN 实现，推荐）--------------------------------
# 评估结论(2026-11-17)：sing-box 1.14 在 WARP 嵌套下重启稳定（mihomo TUN 重启会 DNS 环路），
# 靠 outbound bind_interface 显式绑定（sharenet→utun4、direct→en0）解决上游/环路问题。
SB_BIN="${SB_BIN:-/opt/homebrew/bin/sing-box}"
SB_DIR="$CONFIG_DIR/singbox"
SB_CFG="$SB_DIR/config.json"
SB_LABEL="com.zyc.sharenet-sb"
SB_PLIST="/Library/LaunchDaemons/${SB_LABEL}.plist"

sb_build() {
  [ -x "$SB_BIN" ] || { c_err "未安装 sing-box：brew install sing-box"; return 1; }
  mkdir -p "$SB_DIR" || return 1
  # 确保 direct-extra.yaml / proxy-extra.yaml 已同步最新规则
  DRY_RUN=0 clash_rules_write 2>/dev/null || true
  local mode warp_ifc direct_ifc
  mode="$(cat "$CONFIG_DIR/mode" 2>/dev/null || echo rule)"
  warp_ifc="$(warp_interface)"
  direct_ifc="${DIRECT_IF:-$(printf 'show State:/Network/Global/IPv4\n' | scutil 2>/dev/null | awk '/PrimaryInterface :/{print $3; exit}')}"
  case "$direct_ifc" in ""|utun*) direct_ifc="en0" ;; esac
  python3 - "$MIHOMO_DIR/rules" "$SB_CFG" "$mode" "$PROXY_HOST" "$PROXY_PORT" "$SOCKS_PORT" "$MIHOMO_PORT" "$warp_ifc" "$direct_ifc" <<'PY'
import json,re,sys,os
rules,cfgp,mode,phost,pport,sport,mport,warp_ifc,direct_ifc=sys.argv[1:10]
pport,sport,mport=int(pport),int(sport),int(mport)
def load(f):
    out=[]
    for line in open(os.path.join(rules,f)):
        m=re.search(r"'([^']+)'",line)
        if m: out.append(m.group(1).lstrip('+.'))
    return out
direct=load("direct-extra.yaml"); proxy=load("proxy-extra.yaml")
# 基础规则：sniff + DNS劫持 + 运输层/内网直连（两种模式都必须保留，防环路/远程断连）
# 禁 IPv6 + 拒 QUIC(UDP443)：sharenet 代理不支持 IPv6/UDP，Gemini 等优先 IPv6/QUIC 会卡死，强制 IPv4+TCP
base=[{"action":"sniff"},{"protocol":"dns","action":"hijack-dns"},
 {"ip_cidr":["172.100.0.0/24","162.159.192.0/21","162.159.137.0/24","162.159.36.0/24","162.159.200.0/24","100.64.0.0/10"],"outbound":"direct"},
 {"ip_is_private":True,"outbound":"direct"},
 {"process_name":["CloudflareWARP"],"outbound":"direct"},
 {"ip_cidr":["::/0"],"outbound":"block"},
 {"protocol":"udp","port":[443],"action":"reject"}]
if mode=="global":
    # 全局：除内网/运输层外全部走代理
    rules=base
    dns_rules=[]
else:
    # 规则：国内直连 + 显式代理 + geo 兜底
    rules=base+[{"domain_suffix":direct+["cn"],"outbound":"direct"},
      {"domain_suffix":proxy,"outbound":"PROXY"},
      {"rule_set":["geoip-cn","geosite-cn"],"outbound":"direct"}]
    dns_rules=[{"domain_suffix":direct+["cn"],"server":"cn"}]
cfg={
 "log":{"level":"warn","timestamp":True},
 "dns":{"servers":[
   {"tag":"cn","type":"udp","server":"114.114.114.114","detour":"direct"},
   {"tag":"foreign","type":"https","server":"1.1.1.1","detour":"PROXY"}],
  "rules":dns_rules,
  "final":"foreign","strategy":"ipv4_only"},
 "inbounds":[
  {"type":"tun","tag":"tun-in","address":["172.19.0.1/30"],
   "auto_route":True,"strict_route":True,"stack":"system","mtu":9000},
  {"type":"mixed","tag":"mixed-in","listen":"127.0.0.1","listen_port":mport}],
 "outbounds":[
  {"tag":"PROXY","type":"urltest","outbounds":["sharenet-socks","sharenet-http"],
   "url":"https://www.gstatic.com/generate_204","interval":"300s"},
  {"tag":"sharenet-socks","type":"socks","server":phost,"server_port":sport,"version":"5","bind_interface":warp_ifc},
  {"tag":"sharenet-http","type":"http","server":phost,"server_port":pport,"bind_interface":warp_ifc},
  {"tag":"direct","type":"direct","bind_interface":direct_ifc},
