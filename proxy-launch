pac_build() {
  local i
  mkdir -p "$CONFIG_DIR"
  {
    printf '// 由 proxy-launch 生成，勿手改（改 CN_SUFFIXES 后重跑 proxy-launch pac build）\n'
    printf '// 规则：本地/内网/国内域名 → DIRECT；其余 → PROXY (sharenet %s)\n' "${PROXY_HOST}:${PROXY_PORT}"
    printf 'var CN = [\n'
    for i in $CN_SUFFIXES; do printf "  '%s',\n" "$i"; done
    printf '];\n'
    cat <<'JS'
function _hasSuffix(host, s) {
  return host.length > s.length && host.substring(host.length - s.length) === s;
}
function _isPrivate(host) {
  return /^(10\.|127\.|169\.254\.|192\.168\.|172\.(1[6-9]|2\d|3[01])\.|100\.(6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.)/.test(host);
}
function FindProxyForURL(url, host) {
  host = host.toLowerCase();
  if (isPlainHostName(host) || host === 'localhost') return 'DIRECT';
  if (_isPrivate(host)) return 'DIRECT';
  for (var i = 0; i < CN.length; i++) {
    if (_hasSuffix(host, CN[i])) return 'DIRECT';
  }
  return 'PROXY PROXYHOST; DIRECT';
}
JS
  } > "$PAC_FILE"
  sed -i '' "s/PROXYHOST/${PROXY_HOST}:${PROXY_PORT}/" "$PAC_FILE"
  c_ok "PAC 已生成: ${PAC_FILE}（$(wc -l < "$PAC_FILE" | tr -d ' ') 行）"
}

pac_on() {
  local svc; svc="${PROXY_SERVICE:-$(active_service)}"
  [ -f "$PAC_FILE" ] || pac_build
  # PAC + 静态代理不能同时开，否则静态优先、规则失效
  run_root networksetup -setwebproxystate       "$svc" off
  run_root networksetup -setsecurewebproxystate "$svc" off
  run_root networksetup -setsocksfirewallproxystate "$svc" off
  run_root networksetup -setautoproxyurl "$svc" "file://${PAC_FILE}"
  run_root networksetup -setautoproxystate "$svc" on
  [ "$DRY_RUN" -eq 0 ] && c_ok "PAC 分流已启用（${svc}）：国内直连，其余走 ${PROXY_HOST}:${PROXY_PORT}"
  return 0
}

pac_off() {
  local svc; svc="${PROXY_SERVICE:-$(active_service)}"
  run_root networksetup -setautoproxystate "$svc" off
  # 回到已知可用的静态 HTTP/HTTPS 代理
  run_root networksetup -setwebproxy       "$svc" "$PROXY_HOST" "$PROXY_PORT"
  run_root networksetup -setsecurewebproxy "$svc" "$PROXY_HOST" "$PROXY_PORT"
  run_root networksetup -setwebproxystate   "$svc" on
  run_root networksetup -setsecurewebproxystate "$svc" on
  [ "$DRY_RUN" -eq 0 ] && c_ok "PAC 已关闭，恢复静态 HTTP/HTTPS 代理"
  return 0
}

pac_status() {
  local svc; svc="${PROXY_SERVICE:-$(active_service)}"
  printf '  服务: %s\n' "$svc"
  printf '  PAC 文件: %s %s\n' "$PAC_FILE" "$([ -f "$PAC_FILE" ] && echo "存在" || echo "缺失")"
  scutil --proxy | grep -Ei "ProxyAutoConfigURLString|ProxyAutoConfigEnable|HTTPEnable|HTTPSEnable|SOCKSEnable" | sed 's/^/  /'
  return 0
}

# ---- 常驻服务（LaunchDaemon，以 root 运行，替换开机/重连后丢失的路由）--------
DAEMON_LABEL="com.zyc.proxy-routes"
DAEMON_PLIST="/Library/LaunchDaemons/${DAEMON_LABEL}.plist"
DAEMON_WRAPPER="/usr/local/bin/proxy-routes-sync"
DAEMON_INTERVAL="${DAEMON_INTERVAL:-300}"

routes_daemon_install() {
  local tmpw tmpp owner self abs_cfg
  # 配置目录的真实属主（用 osascript 以 root 安装时不能用 id -un）
  owner="$(stat -f '%Su' "$CONFIG_DIR" 2>/dev/null || id -un)"
  [ -n "$owner" ] || owner="$(id -un)"
  self="$SELF"; abs_cfg="$CONFIG_DIR"; abs_parent="$(dirname "$CONFIG_DIR")"
  tmpw="$(mktemp)"; tmpp="$(mktemp)"
  cat > "$tmpw" <<WRAPPER
#!/bin/sh
# 由 LaunchDaemon 以 root 周期调用：保持 Google 网段路由指向 WARP 隧道
# 隧道不在（WARP 断开）时直接跳过，避免无意义报错
netstat -rn 2>/dev/null | grep -q '^172\.100/24' || exit 0
XDG_CONFIG_HOME="${abs_parent}" "${self}" routes sync
[ -d "${abs_cfg}" ] && chown -R "${owner}" "${abs_cfg}" 2>/dev/null
exit 0
WRAPPER
  cat > "$tmpp" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${DAEMON_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>${DAEMON_WRAPPER}</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>${DAEMON_INTERVAL}</integer>
  <key>StandardOutPath</key><string>/var/log/proxy-routes.log</string>
  <key>StandardErrorPath</key><string>/var/log/proxy-routes.log</string>
</dict>
</plist>
PLIST
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '+ install %s (every %ss) and %s\n' "$DAEMON_PLIST" "$DAEMON_INTERVAL" "$DAEMON_WRAPPER"
    rm -f "$tmpw" "$tmpp"; exit 0
  fi
  # 文件按当前用户身份生成，只有落盘与 launchctl 需要 root（一次授权）
  local cmd
  cmd="cp '$tmpw' '$DAEMON_WRAPPER' && chmod 755 '$DAEMON_WRAPPER' \
&& cp '$tmpp' '$DAEMON_PLIST' && chmod 644 '$DAEMON_PLIST' \
&& (launchctl bootout system '$DAEMON_PLIST' >/dev/null 2>&1 || true) \
&& launchctl bootstrap system '$DAEMON_PLIST'"
  if [ "$(id -u)" -eq 0 ]; then run_cmd /bin/sh -c "$cmd" || return 1
  else run_cmd sudo /bin/sh -c "$cmd" || return 1; fi
  rm -f "$tmpw" "$tmpp"
  c_ok "常驻服务已安装：每 ${DAEMON_INTERVAL}s 检查并补齐路由（日志 /var/log/proxy-routes.log）"
  return 0
}

routes_daemon_uninstall() {
  local cmd
  cmd="launchctl bootout system '$DAEMON_PLIST' >/dev/null 2>&1 || true
rm -f '$DAEMON_PLIST' '$DAEMON_WRAPPER'"
  if [ "$DRY_RUN" -eq 1 ]; then printf '+ %s\n' "$cmd"; exit 0; fi
  if [ "$(id -u)" -eq 0 ]; then run_cmd /bin/sh -c "$cmd" || return 1
  else run_cmd sudo /bin/sh -c "$cmd" || return 1; fi
  c_ok "常驻服务已卸载"
  return 0
}

routes_daemon_status() {
  if launchctl print "system/${DAEMON_LABEL}" >/dev/null 2>&1; then
    c_ok "常驻服务运行中（${DAEMON_LABEL}）"
    launchctl print "system/${DAEMON_LABEL}" 2>/dev/null | grep -E "state|last exit|program|run interval" | sed 's/^/  /'
  else
    c_warn "常驻服务未安装/未运行；用 proxy-launch routes install 安装"
  fi
  return 0
}

usage() {
  local P; P="$(proxy_url)"
  cat <<EOF
proxy-launch —— ChatGPT 和 Claude 默认 HTTP

用法:
  proxy-launch <应用名> [参数...]     启动应用并让它走代理
  proxy-launch -h                    显示本帮助
  proxy-launch -l                    只列出应用名（便于脚本/补全）
  proxy-launch -d <应用名>           只打印将要执行的命令，不真的启动
  proxy-launch status                检查隧道连通性、出口 IP、系统代理状态
  proxy-launch sb on|off|build|status
                                     sing-box TUN（推荐：macOS 重启稳定，接管全部流量含裸socket）
  proxy-launch pac build|on|off|status
                                     PAC 分流：国内域名直连、其余走代理（取代静态系统代理）
  proxy-launch routes on|off|sync|learn|status|install|uninstall|daemon
                                     Google 网段路由维护（Gemini 这类直连 App 的修复）
                                     on 补齐 / off 移除 / sync 补齐+学习 / learn 只学习
                                     status 查看 / install 装常驻服务 / uninstall 卸载 / daemon 看服务状态
  proxy-launch -s <应用名>           额外写入系统代理（需要 sudo），全局生效
  proxy-launch --default http|socks 设定其他应用的系统代理默认类型
  proxy-launch --off                 关闭系统代理（不恢复历史配置）

选项:
  -h, --help     显示帮助
  -l, --list     列出可用应用名
  -d, --dry-run  预演，不执行
  -s, --system   先用 sudo 写入所选类型的系统代理，再启动应用
  -S, --socks    本次改用 SOCKS5 (${PROXY_HOST}:${SOCKS_PORT})
  -H, --http     本次改用 HTTP (${PROXY_HOST}:${PROXY_PORT})
      --default  http|socks  设定系统代理默认类型（写 ${CONFIG_FILE}）
      --off      关闭系统代理

可用应用（proxy-launch -h 之外的第二个参数起原样传给应用）:
  claude      Claude 桌面端（Electron，用 --proxy-server 启动）
  chatgpt     ChatGPT 桌面端（默认自动开启系统 HTTP/HTTPS 代理）
  gemini      Gemini 桌面端（自动开启系统代理，类型读取 --default）
  chrome      Google Chrome（独立 profile，不影响日常窗口）
  claude-cli  终端里的 Claude Code（export 代理变量后 exec claude）
  codex       终端里的 Codex CLI
  zsh         开一个已经设好代理变量的新 shell（最通用）
  git         git（本次调用的 http.proxy，不改全局 config）
  npm / pip / brew   对应包管理器
  curl        curl（加 -x，后面跟普通 curl 参数与 URL）
  status      诊断：隧道/出口 IP/系统代理现状
  routes      Google 网段路由：on 添加 / off 移除 / status 查看（默认 status）
  env         只打印代理环境变量，供 eval 使用

示例:
  proxy-launch claude                       # Claude 桌面端走 HTTP 8443
  proxy-launch chatgpt                      # ChatGPT 走系统 HTTP 8443
  proxy-launch gemini                       # 启动 Gemini（自动开系统代理）
  proxy-launch chrome                       # 启动走代理的 Chrome
  proxy-launch claude-cli                   # 终端里跑 Claude Code
  proxy-launch git clone https://github.com/x/y.git
  proxy-launch -S zsh                       # 用 SOCKS 端口开一个 shell
  proxy-launch -s chrome                    # 写系统代理后再开 Chrome
  eval "\$(proxy-launch env)"                # 给当前终端设好代理变量
  proxy-launch --off                        # 用完关闭系统代理

按应用默认: chatgpt=http，claude=http，claude-cli=http（不受 --default 影响）
其他应用默认代理: ${P}
注意: 系统代理会影响其他遵循系统设置的应用；CLI 和 Claude 的显式代理独立设置。
EOF
}

is_known_app() { app_names | grep -qx "$1"; }

check_tunnel() {
  local port; port="$(selected_port)"
  if ! nc -z -w 3 "$PROXY_HOST" "$port" >/dev/null 2>&1; then
    c_err "隧道不通：${PROXY_HOST}:${port} 无法连接。"
    c_warn "请确认通往 ${PROXY_HOST} 的 VPN / 隧道路由正常。"
    return 1
  fi
  return 0
}

exit_ip() {
  curl -fsS --max-time 10 --noproxy '' -x "$(proxy_url)" https://api.ipify.org 2>/dev/null
}

active_service() {
  local device
  device="$(printf 'show State:/Network/Global/IPv4\n' | scutil | awk '/PrimaryInterface :/{print $3; exit}')"
  [ -n "$device" ] || { c_err "无法识别活动网络，请设置 PROXY_SERVICE。"; return 1; }
  networksetup -listnetworkserviceorder 2>/dev/null \
    | awk -v device="$device" '/^\([0-9]+\) /{name=$0; sub(/^\([0-9]+\) /,"",name)} index($0, "Device: " device ")"){print name; exit}'
}

# 系统代理是否已经是本脚本要的那个地址（避免多余的 sudo 提示）
system_proxy_already_on() {
  local kind="$1"
  [ -n "$kind" ] || kind="$SYSTEM_KIND"
  local out; out="$(scutil --proxy 2>/dev/null)"
  printf '%s\n' "$out" | grep -Eq 'ProxyAuto(Config|Discovery)Enable : 1' && return 1
  if [ "$kind" = "socks" ]; then
    printf '%s\n' "$out" | grep -Eq 'HTTPS?Enable : 1' && return 1
    printf '%s\n' "$out" | grep -q "SOCKSEnable : 1" || return 1
    printf '%s\n' "$out" | grep -Fqx "  SOCKSProxy : ${PROXY_HOST}" || return 1
    printf '%s\n' "$out" | grep -Fqx "  SOCKSPort : ${SOCKS_PORT}" || return 1
  else
    printf '%s\n' "$out" | grep -q "SOCKSEnable : 1" && return 1
    printf '%s\n' "$out" | grep -q "HTTPEnable : 1" || return 1
    printf '%s\n' "$out" | grep -Fqx "  HTTPProxy : ${PROXY_HOST}" || return 1
    printf '%s\n' "$out" | grep -Fqx "  HTTPPort : ${PROXY_PORT}" || return 1
    printf '%s\n' "$out" | grep -q "HTTPSEnable : 1" || return 1
    printf '%s\n' "$out" | grep -Fqx "  HTTPSProxy : ${PROXY_HOST}" || return 1
    printf '%s\n' "$out" | grep -Fqx "  HTTPSPort : ${PROXY_PORT}" || return 1
  fi
  return 0
}

system_proxy_on() {
  local svc="${PROXY_SERVICE:-$(active_service)}"
  local kind="$1"
  [ -n "$kind" ] || kind="$SYSTEM_KIND"
  [ -n "$svc" ] || { c_err "未找到活动网络服务，请设置 PROXY_SERVICE。"; return 1; }
  echo "服务: ${svc}"
  run_cmd sudo networksetup -setautoproxystate "$svc" off || return 1
  run_cmd sudo networksetup -setproxyautodiscovery "$svc" off || return 1
  if [ "$kind" = "socks" ]; then
    run_cmd sudo networksetup -setwebproxystate       "$svc" off || return 1
    run_cmd sudo networksetup -setsecurewebproxystate "$svc" off || return 1
    run_cmd sudo networksetup -setsocksfirewallproxy  "$svc" "$PROXY_HOST" "$SOCKS_PORT" || return 1
    run_cmd sudo networksetup -setsocksfirewallproxystate "$svc" on || return 1
    [ "$DRY_RUN" -eq 0 ] && c_ok "系统代理已开启（SOCKS5 -> ${PROXY_HOST}:${SOCKS_PORT}，HTTP/HTTPS 代理已关闭）"
  else
    run_cmd sudo networksetup -setsocksfirewallproxystate "$svc" off || return 1
    run_cmd sudo networksetup -setwebproxy        "$svc" "$PROXY_HOST" "$PROXY_PORT" || return 1
    run_cmd sudo networksetup -setsecurewebproxy  "$svc" "$PROXY_HOST" "$PROXY_PORT" || return 1
    run_cmd sudo networksetup -setwebproxystate   "$svc" on || return 1
    run_cmd sudo networksetup -setsecurewebproxystate "$svc" on || return 1
    [ "$DRY_RUN" -eq 0 ] && c_ok "系统代理已开启（HTTP/HTTPS -> ${PROXY_HOST}:${PROXY_PORT}，SOCKS 已关闭）"
  fi
  return 0
}

system_proxy_off() {
  local svc="${PROXY_SERVICE:-$(active_service)}"
  [ -n "$svc" ] || { c_err "未找到活动网络服务，请设置 PROXY_SERVICE。"; return 1; }
  run_cmd sudo networksetup -setwebproxystate       "$svc" off || return 1
  run_cmd sudo networksetup -setsecurewebproxystate "$svc" off || return 1
  run_cmd sudo networksetup -setsocksfirewallproxystate "$svc" off || return 1
  if [ "$DRY_RUN" -eq 0 ]; then c_ok "系统代理已关闭（${svc}）"; fi
}

show_status() {
  local svc="${PROXY_SERVICE:-$(active_service)}"
  c_info "== 隧道 =="
  printf '  %-24s' "${PROXY_HOST}:${PROXY_PORT}"
  if nc -z -w 3 "$PROXY_HOST" "$PROXY_PORT" >/dev/null 2>&1; then c_ok "可达"; else c_err "不可达"; fi
  printf '  %-24s' "${PROXY_HOST}:${SOCKS_PORT}"
  if nc -z -w 3 "$PROXY_HOST" "$SOCKS_PORT" >/dev/null 2>&1; then c_ok "可达"; else c_err "不可达"; fi
  c_info "== 出口 IP =="
  local ip; ip="$(exit_ip)"
  if [ -n "$ip" ]; then printf '  %s\n' "$ip"; else c_warn "  取不到（隧道未通或 api.ipify.org 被拦）"; fi
  c_info "== 系统代理（${svc}）=="
  printf '  应用默认: ChatGPT=HTTP，Claude=HTTP，Claude Code=HTTP\n'
  printf '  其他系统代理默认类型: %s\n' "$SYSTEM_KIND"
  scutil --proxy | grep -Ei "HTTPEnable|HTTPSEnable|SOCKSEnable|SOCKSProxy|SOCKSPort|ProxyAutoConfigEnable|HTTPPort" | sed 's/^/  /'
  c_info "== 已运行的 GUI 应用 =="
  for a in Claude "Google Chrome"; do
    if pgrep -x "$a" >/dev/null 2>&1; then printf '  %s: 运行中' "$a"; else printf '  %s: 未运行' "$a"; fi
    echo
  done
  [ -x /usr/sbin/lsof ] && pgrep -x Claude >/dev/null 2>&1 && {
    c_info "== Claude 进程的代理连接 =="
    lsof -i -nP -a -p "$(pgrep -x Claude)" 2>/dev/null | grep -E "ESTABLISHED" | head -5 | sed 's/^/  /'
  }
  return 0
}

run_app() {
  local app="$1"; shift
  # 规则网关（mihomo）在跑时优先指向它，让 CLI/环境变量也享受国内直连的分流
  local p cp
  if clash_gateway_active; then
    p="http://127.0.0.1:${MIHOMO_PORT}"
    cp="$p"
  else
    p="$(proxy_url)"
    cp="$(chromium_proxy)"
  fi

  case "$app" in
    claude)
      local bin="/Applications/Claude.app"
      [ -d "$bin" ] || { c_err "未找到 ${bin}"; return 1; }
      run_cmd osascript -e 'if application "Claude" is running then tell application "Claude" to quit' || return 1
      run_cmd open -na "$bin" --args --proxy-server="$cp" \
        --proxy-bypass-list="<-loopback>;localhost;127.0.0.1" "$@" || return 1
      [ "$DRY_RUN" -eq 0 ] && c_ok "已启动 Claude（代理 ${cp}）"
      return 0
      ;;
    chatgpt|gemini)
      local display bin weburl
      case "$app" in
        chatgpt) display="ChatGPT"; bin="/Applications/ChatGPT.app"; weburl="https://chatgpt.com/" ;;
        gemini)  display="Gemini";  bin="/Applications/Gemini.app";  weburl="https://gemini.google.com/app" ;;
      esac
      if [ -d "$bin" ]; then
        run_cmd osascript -e "if application \"$display\" is running then tell application \"$display\" to quit" || return 1
        if [ "$app" = "gemini" ]; then
          # Gemini 的 gRPC(Antigravity) 不读系统代理、只认 https_proxy env；
          # 且必须经 LaunchServices(open) 启动才能正常激活窗口（nohup 拉二进制会无响应）。
          # 用 launchctl setenv 注入 env → open → 立即 unsetenv，不影响其它应用。
          c_warn "Gemini 以代理 env + LaunchServices 启动"
          local v
          for v in HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy; do
            run_cmd launchctl setenv "$v" "$p"
          done
          run_cmd open -a "$display" || return 1
          for v in HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy; do
            run_cmd launchctl unsetenv "$v"
          done
        else
          run_cmd open -na "$bin" --args "$@" || return 1
        fi
        [ "$DRY_RUN" -eq 0 ] && c_ok "已启动 ${display}（代理 ${p}）"
      else
        c_warn "未找到 ${bin}，改用走代理的 Chrome 打开 ${weburl}"
        run_cmd open -na "/Applications/Google Chrome.app" --args \
          --proxy-server="$(chromium_proxy)" \
          --proxy-bypass-list="<-loopback>;localhost;127.0.0.1" \
          --user-data-dir="$CHROME_PROFILE" --app="$weburl" "$@" || return 1
      fi
      return 0
      ;;
    chrome)
      local bin="/Applications/Google Chrome.app"
      [ -d "$bin" ] || { c_err "未找到 ${bin}"; return 1; }
      run_cmd open -na "$bin" --args --proxy-server="$cp" \
        --proxy-bypass-list="<-loopback>;localhost;127.0.0.1" \
        --user-data-dir="$CHROME_PROFILE" "$@" || return 1
      [ "$DRY_RUN" -eq 0 ] && c_ok "已启动 Chrome（独立 profile: ${CHROME_PROFILE}）"
      return 0
      ;;
    claude-cli)
      run_cmd env HTTP_PROXY="$p" HTTPS_PROXY="$p" ALL_PROXY="$p" \
        http_proxy="$p" https_proxy="$p" all_proxy="$p" \
        NO_PROXY="localhost,127.0.0.1,::1" no_proxy="localhost,127.0.0.1,::1" claude "$@"
      ;;
    codex)
      run_cmd env HTTP_PROXY="$p" HTTPS_PROXY="$p" ALL_PROXY="$p" \
        NO_PROXY="localhost,127.0.0.1" codex "$@"
      ;;
    zsh)
      c_info "进入已设置代理的子 shell，退出即失效。"
      run_cmd env HTTP_PROXY="$p" HTTPS_PROXY="$p" ALL_PROXY="$p" \
        NO_PROXY="localhost,127.0.0.1" "${SHELL:-/bin/zsh}" "$@"
      ;;
    git)
      run_cmd env GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.proxy GIT_CONFIG_VALUE_0="$p" \
        git "$@"
      ;;
    npm)
      run_cmd env npm_config_proxy="$p" npm_config_https_proxy="$p" \
        HTTP_PROXY="$p" HTTPS_PROXY="$p" npm "$@"
      ;;
    pip)
      run_cmd env HTTP_PROXY="$p" HTTPS_PROXY="$p" pip "$@"
      ;;
    brew)
      run_cmd env HTTP_PROXY="$p" HTTPS_PROXY="$p" ALL_PROXY="$p" \
        NO_PROXY="localhost,127.0.0.1" brew "$@"
      ;;
    curl)
      run_cmd curl --proxy "$p" "$@"
      ;;
    env)
      printf 'export HTTP_PROXY="%s"\n' "$p"
      printf 'export HTTPS_PROXY="%s"\n' "$p"
      printf 'export ALL_PROXY="%s"\n' "$p"
      printf 'export NO_PROXY="localhost,127.0.0.1"\n'
      ;;
    *)
      c_err "未知应用: $app"
      c_warn "可用: $(app_names | tr '\n' ' ')"
      return 2
      ;;
  esac
}

run_cmd() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '+'
    printf ' %q' "$@"
    printf '\n'
    return 0
  fi
  "$@"
}

set_default() {
  local kind="$1"
  case "$kind" in
    http|socks) ;;
    *) c_err "--default 只接受 http 或 socks"; exit 2 ;;
  esac
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '+ echo SYSTEM_KIND=%s > %s\n' "$kind" "$CONFIG_FILE"
    exit 0
  fi
  mkdir -p "$CONFIG_DIR" || exit 1
  printf 'SYSTEM_KIND=%s\n' "$kind" > "$CONFIG_FILE" || exit 1
  c_ok "已设置默认系统代理类型: ${kind}（写入 ${CONFIG_FILE}）"
  if [ "$kind" = "socks" ]; then
    c_warn "ChatGPT、Claude 桌面端及 CLI 默认 HTTP，不受 --default 影响。"
  fi
  exit 0
}

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)   usage; exit 0 ;;
      -l|--list)   LIST_ONLY=1; shift ;;
      -d|--dry-run) DRY_RUN=1; shift ;;
      -s|--system) MODE="system"; shift ;;
      -S|--socks)  PROTOCOL_OVERRIDE="socks"; shift ;;
      -H|--http)   PROTOCOL_OVERRIDE="http"; shift ;;
      --default)   shift; set_default "${1:-}"; shift ;;
      --off)       MODE="off"; shift ;;
      --)          shift; break ;;
      -*)          c_err "未知选项: $1"; usage >&2; exit 2 ;;
      *)           break ;;
    esac
  done

  [ "$LIST_ONLY" -eq 1 ] && { app_names; exit 0; }

  if [ "$MODE" = "off" ]; then system_proxy_off; exit $?; fi

  if [ $# -eq 0 ]; then
    c_err "缺少应用名"; echo; usage >&2; exit 2
  fi

  local app="$1"; shift

  if [ "$app" = "off" ]; then all_off; exit $?; fi
  if [ "$app" = "on" ]; then all_on; exit $?; fi
  if [ "$app" = "sj" ]; then status_json; exit $?; fi
  if [ "$app" = "mode" ]; then set_mode "${1:-}"; exit $?; fi

  if [ "$app" = "sb" ]; then
    case "${1:-status}" in
      on) sb_on;; off) sb_off;; build) sb_build;; status|"") sb_status;;
      *) c_err "sb 只接受 on/off/build/status"; exit 2;;
    esac
    exit $?
  fi

  if [ "$app" = "clash" ]; then
    local cact="${1:-status}"
    case "$cact" in
      build)  clash_build;  exit $? ;;
      agent)  clash_agent_install; exit $? ;;
      on)     clash_on;     exit $? ;;
      off)    clash_off;    exit $? ;;
      tun-on)  clash_tun_on;  exit $? ;;
      tun-off) clash_tun_off; exit $? ;;
      status|"") clash_status; exit $? ;;
      *)      c_err "clash 只接受 build / on / off / status"; exit 2 ;;
    esac
  fi

  if [ "$app" = "pac" ]; then
    local act="${1:-status}"
    case "$act" in
      build)  pac_build;   exit $? ;;
      on)     pac_on;      exit $? ;;
      off)    pac_off;     exit $? ;;
      status|"") pac_status; exit $? ;;
      *)      c_err "pac 只接受 build / on / off / status"; exit 2 ;;
    esac
  fi

  if [ "$app" = "routes" ]; then
    case "${1:-status}" in
      on)     google_routes_on; exit $? ;;
      off)    google_routes_off; exit $? ;;
      sync)   routes_sync; exit $? ;;
      learn)  learn_new_nets; exit $? ;;
      install)   routes_daemon_install; exit $? ;;
      uninstall) routes_daemon_uninstall; exit $? ;;
      daemon)    routes_daemon_status; exit $? ;;
      status|"") google_routes_status; exit $? ;;
      *)      c_err "routes 只接受 on / off / sync / learn / install / uninstall / daemon / status"; exit 2 ;;
    esac
  fi

  select_protocol "$app" || exit $?
  if [ "$app" = "status" ]; then show_status; exit 0; fi
  if [ "$app" = "env" ] && [ "$MODE" = "app" ]; then run_app env; exit 0; fi
  if ! is_known_app "$app"; then
    c_err "未知应用: $app"; c_warn "可用: $(app_names | tr '\n' ' ')"; exit 2
  fi

  if [ "$DRY_RUN" -eq 0 ]; then check_tunnel || exit 1; fi

  # 检查、诊断、系统设置和启动参数共用同一次协议选择。
  local sys_kind="http"
  [ "$USE_SOCKS" -eq 1 ] && sys_kind="socks"

  # 原生 App 使用系统代理，必要时自动开启（--off 关闭）。
  if needs_system_proxy "$app" && [ "$MODE" != "system" ]; then
    if system_proxy_already_on "$sys_kind"; then
      c_ok "系统代理已是 ${sys_kind} 模式（${PROXY_HOST}），无需改动"
    else
      c_warn "该应用将使用系统 ${sys_kind} 代理（修改设置需要 sudo 权限）…"
      system_proxy_on "$sys_kind" || exit 1
    fi
  fi

  if [ "$MODE" = "system" ]; then
    system_proxy_on "$sys_kind" || exit 1
  fi

  if [ "$DRY_RUN" -eq 0 ]; then
    local ip; ip="$(exit_ip)"
    [ -n "$ip" ] && c_info "出口 IP: $ip"
  fi

  run_app "$app" "$@"
  exit $?
}

main "$@"
