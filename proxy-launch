# 由 proxy-launch 生成 —— sharenet 规则分流（国内直连 / 其余走隧道）
mixed-port: ${MIHOMO_PORT}
allow-lan: false
bind-address: 127.0.0.1
mode: rule
log-level: warning
ipv6: false
unified-delay: true
tcp-concurrent: true
external-controller: ${MIHOMO_API}
find-process-mode: "off"
geodata-mode: true
geo-auto-update: false
${TUN_BLOCK}

rule-providers:
