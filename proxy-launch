# 模式切换：global=全走代理 / rule=国内直连分流
set_mode() {
  local m="$1"
  case "$m" in global|rule) ;; *) c_err "mode 只接受 global / rule"; return 2;; esac
  printf '%s\n' "$m" > "$CONFIG_DIR/mode"
  sb_build || return 1
  if launchctl print "system/${SB_LABEL}" >/dev/null 2>&1; then
    run_root /bin/launchctl kickstart -k "system/${SB_LABEL}"
    c_ok "已切换为 ${m} 模式并重载 sing-box"
  else
    c_ok "已设为 ${m} 模式（sing-box 未运行，sb on 后生效）"
  fi
}

sb_on() {
  sb_build || return 1
  if [ "$DRY_RUN" -eq 1 ]; then printf '+ install root sing-box TUN %s\n' "$SB_PLIST"; return 0; fi
  local owner_uid; owner_uid="$(stat -f %u "$CONFIG_DIR" 2>/dev/null || id -u)"
  launchctl bootout "gui/${owner_uid}/${AGENT_LABEL}" 2>/dev/null || true   # 停 mihomo 释放7890
  launchctl bootout system "$TUN_PLIST" 2>/dev/null || true               # 停 mihomo TUN(若存在)
  sleep 1
  local tmp; tmp="$(mktemp)"
  cat > "$tmp" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>${SB_LABEL}</string>
<key>ProgramArguments</key><array><string>${SB_BIN}</string><string>run</string><string>-c</string><string>${SB_CFG}</string><string>-D</string><string>${SB_DIR}</string></array>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>${SB_DIR}/sb.log</string>
<key>StandardErrorPath</key><string>${SB_DIR}/sb.log</string>
</dict></plist>
PLIST
  run_root /bin/cp "$tmp" "$SB_PLIST" && run_root /bin/chmod 644 "$SB_PLIST" && rm -f "$tmp"
  run_root /bin/launchctl bootout system "$SB_PLIST" >/dev/null 2>&1 || true
  run_root /bin/launchctl bootstrap system "$SB_PLIST" || { c_err "sing-box daemon 启动失败"; return 1; }
  sleep 3
  nc -z -w 2 127.0.0.1 "$MIHOMO_PORT" || { c_err "sing-box 7890 未监听"; return 1; }
  c_ok "sing-box TUN 已启用（root 常驻，接管全部流量，重启稳定）"
  return 0
}

sb_off() {
  if [ "$DRY_RUN" -eq 1 ]; then printf '+ remove sing-box TUN, restore user mihomo\n'; return 0; fi
  run_root /bin/launchctl bootout system "$SB_PLIST" >/dev/null 2>&1 || true
  run_root /bin/rm -f "$SB_PLIST"
  MIHOMO_TUN=0 clash_build || return 1
  clash_agent_install || return 1
  c_ok "已退出 sing-box TUN，恢复用户级 mihomo"
  return 0
}

sb_status() {
  printf '  sing-box: %s\n' "$SB_BIN"
  if launchctl print "system/${SB_LABEL}" >/dev/null 2>&1; then
    c_ok "sing-box TUN 运行中"
  else
    c_warn "sing-box TUN 未运行"
  fi
  nc -z -w 1 127.0.0.1 "$MIHOMO_PORT" >/dev/null 2>&1 && c_ok "7890 监听中" || c_warn "7890 未监听"
  return 0
}

# JSON 状态，供菜单栏 GUI 读取（快速，不做网络请求）
status_json() {
  local sb=0 tun=0 mu=0 warp=0 port=0 sys=0 route=0
  launchctl print "system/${SB_LABEL}" >/dev/null 2>&1 && sb=1
  launchctl print "system/${TUN_LABEL}" >/dev/null 2>&1 && tun=1
  launchctl print "gui/$(id -u)/${AGENT_LABEL}" >/dev/null 2>&1 && mu=1
  "/Applications/Cloudflare WARP.app/Contents/Resources/warp-cli" status 2>/dev/null | head -1 | grep -q Connected && warp=1
  nc -z -w 1 127.0.0.1 "$MIHOMO_PORT" >/dev/null 2>&1 && port=1
  scutil --proxy 2>/dev/null | grep -q "HTTPEnable : 1" && sys=1
  netstat -rn 2>/dev/null | grep -q "172.100/24" && route=1
  local mode; mode="$(cat "$CONFIG_DIR/mode" 2>/dev/null || echo rule)"
  printf '{"sb":%d,"tun":%d,"mihomo":%d,"warp":%d,"port":%d,"sysproxy":%d,"route":%d,"mode":"%s"}\n' "$sb" "$tun" "$mu" "$warp" "$port" "$sys" "$route" "$mode"
}

# ---- 总开关：off=纯直连（关 sb+mihomo+系统代理），on=恢复 sing-box TUN ----------
# 依赖关系：WARP 只是 sharenet 的运输层；sb TUN 接管默认路由。
# 只关 WARP 不关 sb → 境外上游失效(境外断)、国内仍直连，不会全断网。
# 要纯直连必须关 sb(否则它仍接管路由)并关系统代理；WARP 可关可不关。
all_off() {
  if [ "$DRY_RUN" -eq 1 ]; then printf '+ stop sb/mihomo, disable system proxy (pure direct)\n'; return 0; fi
  local owner_uid; owner_uid="$(stat -f %u "$CONFIG_DIR" 2>/dev/null || id -u)"
  run_root /bin/launchctl bootout system "$SB_PLIST" >/dev/null 2>&1 || true
  run_root /bin/launchctl bootout system "$TUN_PLIST" >/dev/null 2>&1 || true
  launchctl bootout "gui/${owner_uid}/${AGENT_LABEL}" 2>/dev/null || true
  local svc; svc="${PROXY_SERVICE:-$(active_service)}"
  run_root networksetup -setwebproxystate       "$svc" off
  run_root networksetup -setsecurewebproxystate "$svc" off
  run_root networksetup -setsocksfirewallproxystate "$svc" off
  run_root networksetup -setautoproxystate      "$svc" off
  c_ok "已关闭全部代理 → 纯直连（国内正常，境外按墙的现状）。WARP 可另关：warp-cli disconnect"
  return 0
}

all_on() {
  sb_on || return 1
  local svc; svc="${PROXY_SERVICE:-$(active_service)}"
  run_root networksetup -setwebproxy       "$svc" 127.0.0.1 "$MIHOMO_PORT"
  run_root networksetup -setsecurewebproxy "$svc" 127.0.0.1 "$MIHOMO_PORT"
  run_root networksetup -setwebproxystate   "$svc" on
  run_root networksetup -setsecurewebproxystate "$svc" on
  c_ok "已恢复 sing-box TUN 分流"
  return 0
}

